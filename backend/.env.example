DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mutual_checks
SUBMISSION_UPLOAD_DIR=uploads/submissions
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
JWT_ISSUER=mutual-checks-api
JWT_AUDIENCE=mutual-checks-frontend
CORS_ORIGINS=["http://localhost:5173"]
